generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH DOMAIN ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SUPPORT
  CUSTOMER
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?  // null para usuarios Google
  googleId         String?  @unique
  name             String?
  phone            String?
  role             Role     @default(CUSTOMER)
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  addresses     Address[]
  orders        Order[]
  wishlistItems WishlistItem[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resource     String
  resourceId   String?
  changes      Json?
  ip           String?
  userAgent    String?
  status       String   @default("success")
  errorMessage String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ─── ADDRESS DOMAIN ──────────────────────────────────────────────────────────

model Address {
  id       String @id @default(uuid())
  userId   String
  alias    String // "Casa", "Trabajo", etc.

  fullName  String
  rut       String  // requerido por Starken Chile
  email     String?
  phone     String
  region    String
  ciudad    String
  comuna    String  // requerido por Starken
  calle     String
  numero    String  // puede ser "S/N"
  depto     String?
  referencia String?

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─── PRODUCTS DOMAIN ─────────────────────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

model Product {
  id          String        @id @default(uuid())
  title       String
  slug        String?       @unique
  description String?
  brand       String?
  status      ProductStatus @default(ACTIVE)
  featured    Boolean       @default(false)
  mlItemId    String?
  images      String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  variants      ProductVariant[]
  mlListings    MlListing[]
  tags          ProductTag[]
  wishlistItems WishlistItem[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  sku           String   @unique
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  mlVariationId String?
  images        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes        VariantAttribute[]
  stockMovements    StockMovement[]
  orderItems        OrderItem[]
  mlListingVariants MlListingVariant[]

  @@index([productId])
  @@map("product_variants")
}

model VariantAttribute {
  id        String @id @default(uuid())
  variantId String
  name      String
  value     String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, name])
  @@map("variant_attributes")
}

// ─── TAGS ────────────────────────────────────────────────────────────────────

model Tag {
  id    String  @id @default(uuid())
  name  String  @unique
  slug  String  @unique
  color String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]

  @@index([slug])
  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
  @@map("product_tags")
}

// ─── STOCK DOMAIN ────────────────────────────────────────────────────────────

enum StockSource {
  WEB
  ML
  ADMIN
}

enum ReferenceType {
  ORDER
  ML_SALE
  MANUAL
}

model StockMovement {
  id            String        @id @default(uuid())
  variantId     String
  quantity      Int
  source        StockSource
  referenceType ReferenceType
  referenceId   String?
  externalId    String?       @unique
  userId        String?
  createdAt     DateTime      @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([referenceId])
  @@map("stock_movements")
}

// ─── ORDERS DOMAIN ───────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderOrigin {
  WEB
  ML
  CARD
  TRANSFER
  CASH
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  addressId   String?
  status      OrderStatus @default(PENDING)
  origin      OrderOrigin @default(WEB)
  totalAmount Decimal     @db.Decimal(10, 2)

  trackingCode  String?
  shippingLabel String?  // ZPL generado para Starken

  customerNotes String?
  adminNotes    String?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  address Address?  @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─── PAYMENTS DOMAIN ─────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  SETTLED
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  gatewayId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order     Order             @relation(fields: [orderId], references: [id])
  eventLogs PaymentEventLog[]

  @@map("payments")
}

model PaymentEventLog {
  id          String        @id @default(uuid())
  paymentId   String
  fromStatus  PaymentStatus
  toStatus    PaymentStatus
  triggeredBy String
  payload     Json?
  createdAt   DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_event_logs")
}

// ─── OBSERVABILITY ───────────────────────────────────────────────────────────

model ProductView {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  viewedAt  DateTime @default(now())

  @@index([productId])
  @@index([productId, viewedAt])
  @@map("product_views")
}

// ─── WISHLIST ─────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─── MERCADOLIBRE INTEGRATION ─────────────────────────────────────────────────

model MlToken {
  id           String   @id @default(uuid())
  sellerId     String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ml_tokens")
}

model MlListing {
  id        String   @id @default(uuid())
  productId String
  mlItemId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants MlListingVariant[]

  @@index([productId])
  @@map("ml_listings")
}

model MlListingVariant {
  id            String   @id @default(uuid())
  listingId     String
  variantId     String
  mlVariationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing MlListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([listingId, variantId])
  @@unique([listingId, mlVariationId])
  @@index([variantId])
  @@index([mlVariationId])
  @@map("ml_listing_variants")
}
